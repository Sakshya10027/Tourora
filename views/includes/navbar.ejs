<style>
  .btn-search{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }
  .btn-search:hover{
    background-color: #fe424d;
    color: #fff;
  }
  .btn-search i{
    display: inline;
  }
  .search-input{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }
  @media (max-width: 768px) {
    .navbar-nav.ms-auto.search-container {
      width: auto;
      flex-grow: 1;
      margin: 0 0.5rem;
    }
    .search-input {
      padding: 0.5rem 0.8rem;
      width: 100%;
      font-size: 0.9rem;
    }
    .navbar-brand {
      margin-right: 0.5rem;
    }
    .navbar-collapse {
      width: 100%;
      background-color: #f8f9fa;
      border-radius: 0.5rem;
      margin-top: 0.5rem;
      padding: 1rem;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .nav-link {
      padding: 0.8rem 1rem !important;
      border-bottom: 1px solid #dee2e6;
    }
    .nav-link:last-child {
      border-bottom: none;
    }
  }

  /* Laptop/Desktop specific fixes */
  @media (min-width: 768px) {
    .search-container {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: auto;
      max-width: 400px;
    }
    .container-fluid {
      position: relative;
    }
    .navbar-collapse {
      width: 100%;
      display: flex !important;
      justify-content: space-between;
    }
    .top-row-container {
      width: auto !important;
    }
    .navbar-toggler {
      display: none;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-light border-bottom sticky-top">
  <div class="container-fluid d-flex align-items-center">
    <!-- Brand Logo -->
    <a class="navbar-brand" href="/"><i class="fa-brands fa-avianex"></i></a>

    <!-- Search Bar (Centered on Desktop, in-line on Mobile) -->
    <div class="navbar-nav search-container">
      <form class="d-flex" role="search" action="/listings" method="GET">
        <input class="form-control me-2 search-input" type="search" placeholder="Search Destination" name="search"/>
        <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
      </form>
    </div>

    <!-- Mobile Toggler -->
    <button
      class="navbar-toggler ms-auto"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collapsible Menu -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a> 
      </div>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add your Listing</a>
        <% if(!currUser){ %>
        <a class="nav-link" href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
        <% if(currUser){ %>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
